{
    "include": [
        "src/**/*.ts"
    ],
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "strict": true,
        "allowJs": false,
        "outDir": "./dist",
        "esModuleInterop": true,                            
        "forceConsistentCasingInFileNames": true,       
    }
}